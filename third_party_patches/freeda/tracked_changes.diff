+def _save_tfovos_prediction(dataset, batch_index, pred):
+    root = os.environ.get("FREEDA_SAVE_ROOT")
+    ds_name = os.environ.get("FREEDA_DATASET_NAME")
+    if not root or not ds_name:
+        return
+    try:
+        info = dataset.dataset.img_infos[int(batch_index) + dataset.indices.start]
+        filename = info.get("filename") or info.get("img_info", {}).get("filename") or str(batch_index)
+    except Exception:
+        filename = str(batch_index)
+    stem = Path(filename).stem
+    arr = np.asarray(pred, dtype=np.int32)
+    if ds_name in {"voc20", "context59", "ade20k", "coco_stuff164k"}:
+        arr = arr + 1
+    out_dir = Path(root) / "freeda" / ds_name
+    out_dir.mkdir(parents=True, exist_ok=True)
+    if arr.max(initial=0) > 255:
+        Image.fromarray(arr.astype(np.uint16), mode="I;16").save(out_dir / f"{stem}.png")
+    else:
+        Image.fromarray(arr.astype(np.uint8), mode="L").save(out_dir / f"{stem}.png")
+
