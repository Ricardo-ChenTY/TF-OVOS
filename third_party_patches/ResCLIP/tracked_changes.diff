+def _merge_synonym_probs(seg_probs, query_idx, num_cls, num_queries):
+    if num_cls == num_queries:
+        return seg_probs
+    merged = seg_probs.new_zeros((num_cls, *seg_probs.shape[1:]))
+    for cls_id in range(num_cls):
+        query_ids = (query_idx == cls_id).nonzero(as_tuple=False).flatten()
+        if query_ids.numel() > 0:
+            merged[cls_id] = seg_probs.index_select(0, query_ids).amax(0)
+    return merged
+
