  "claims": [
    {
      "id": "obs1",
      "page": 6,
      "claim": "VFM-assisted training-free methods are competitive on compact vocabularies",
      "status": "CorrCLIP_all_four_compact_scores_reproduced_from_saved_maps_proposal_reruns_pending",
      "caveat": "FreeDA COCO saved outputs score27.0244 versus submitted28.80 under corrected GT/rejection handling; native provenance remains to reconcile."
    },
    {
      "id": "obs2",
      "page": 6,
      "claim": "Compact vocabulary accuracy does not certify open-vocabulary reliability",
      "status": "paired_E2_descriptive_evidence_retained_fixed_GT_experiments_running",
      "caveat": "Submitted page 8 explicitly acknowledges taxonomy and annotation confounding; do not claim manuscript attributes most loss to candidate competition."
    },
    {
      "id": "obs3",
      "page": 7,
      "claim": "Class-agnostic objectness alone is insufficient for dense semantic parsing",
      "status": "eight_method_same_image_COCO_split_complete_corrected_proposal_inference_pending",
      "caveat": "Stuff mIoU is lower for all eight. Four historical proposal rows have comparable/higher dense-map matching coverage on stuff but higher conditional mismatch. This does not establish a causal native-proposal objectness explanation; proposal preprocessing reruns pending."
    },
    {
      "id": "obs4",
      "page": 8,
      "claim": "Class silence is a prominent large-vocabulary failure signature",
      "status": "ten_method_Context_ADE_official_GT_rescoring_complete_wording_and_ADE_values_require_revision",
      "caveat": "Zero IoU is not never predicted. ADE847 uses847 GT-supported classes after official ID correction. CorrCLIP8.67→9.5109, SAN10.24→10.0326; degradation direction preserved, small rankings shift."
    },
    {
      "id": "obs5",
      "page": 8,
      "claim": "Localization and naming are separable bottlenecks",
      "status": "metric_comparability_and_probe_attribution_require_revision",
      "caveat": "0.623 oracle / 0.663 recall are shared SAM ViT-H reference, not necessarily native CorrCLIP proposals. Full-vocabulary argmax is naming dependent. Lower SAN MCMR alone does not isolate effect of training."
    },
    {
      "id": "obs6",
      "page": 10,
      "claim": "Worst-target mIoU exposes fragility that averages hide",
      "status": "same_image_COCO_split_added_full_corrected_proposal_inference_pending",
      "caveat": "Cross-target difficulty and vocabulary differ; within-dataset thing/stuff control still needed."
    },
    {
      "id": "obs7",
      "page": 10,
      "claim": "Efficiency changes the usable Pareto set",
      "status": "uniform_E4_reruns_pending",
      "caveat": "Historical timing sources mix scope/hardware; no corrected Pareto claim before uniform timing."
    },
    {
      "id": "obs8",
      "page": 12,
      "claim": "A single mIoU number merges distinct failure modes",
      "status": "qualitative_thesis_retained_specific_evidence_needs_recalibration",
      "caveat": "Zero-IoU, conditional MCMR and localization failures are not disjoint. CLIPtrase crop geometry invalidates old stretched-map diagnostics."
    },
    {
      "id": "obs9",
      "page": 12,
      "claim": "Small and fragmented regions are a recurring weak point",
      "status": "five_methods_complete_ADE150_direction_preserved_at_min_area64_and128",
      "caveat": "At min_area128 legacy counts/IoUs reproduce exactly. Corrected same-class component matching retains large>medium>small for all5 methods. CorrCLIP0.5241/0.2489/0.0672 on ADE150. Other targets and whole-paper pooled values pending."
    }
  ]
